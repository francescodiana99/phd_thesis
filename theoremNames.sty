
\usepackage{mdframed}

\AtBeginDocument{
	%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
	% Environnement pour les théorèmes, définitions, exemples et autre   %
	%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

	\declaretheoremstyle[
		headfont=\bfseries\color{citeColor},
		bodyfont=\normalfont,
		headpunct={\quad},
		postheadspace=0pt,
		mdframed={
			backgroundcolor=citeColor!5,
			linecolor=citeColor,
			linewidth=2.2pt,
			topline=false,
			bottomline=false,
			rightline=false,
			innertopmargin=7pt,
			innerbottommargin=7pt,
			innerleftmargin=11pt,
			innerrightmargin=11pt,
			skipabove=10pt,
			skipbelow=10pt
		}
	]{thesisstatement}

	\declaretheoremstyle[
		headfont=\bfseries\color{linkColor},
		bodyfont=\normalfont,
		headpunct={\quad},
		postheadspace=0pt,
		mdframed={
			backgroundcolor=linkColor!5,
			linecolor=linkColor,
			linewidth=2.2pt,
			topline=false,
			bottomline=false,
			rightline=false,
			innertopmargin=7pt,
			innerbottommargin=7pt,
			innerleftmargin=11pt,
			innerrightmargin=11pt,
			skipabove=10pt,
			skipbelow=10pt
		}
	]{thesisassumption}

	\declaretheoremstyle[
		headfont=\bfseries\color{citeColor},
		bodyfont=\normalfont,
		headpunct={\quad},
		postheadspace=0pt,
		mdframed={
			backgroundcolor=citeColor!5,
			linecolor=citeColor,
			linewidth=2.2pt,
			topline=false,
			bottomline=false,
			rightline=false,
			innertopmargin=7pt,
			innerbottommargin=7pt,
			innerleftmargin=11pt,
			innerrightmargin=11pt,
			skipabove=10pt,
			skipbelow=10pt
		}
	]{thesisdefinition}

	\declaretheorem[style=thesisstatement,name=Theorem,numberwithin=section]{theorem}
	\declaretheorem[style=thesisstatement,name=Lemme,sibling=theorem]{lemma}
	\declaretheorem[style=thesisstatement,name=Proposition,sibling=theorem]{proposition}
	\declaretheorem[style=thesisstatement,name=Proposition,sibling=theorem]{prop}
	\declaretheorem[style=thesisstatement,name=Corollaire,sibling=theorem]{corollary}
	\declaretheorem[style=thesisstatement,name=Preuve,numberwithin=chapter]{preuve}
	\declaretheorem[style=thesisassumption,name=Assumption,numberwithin=section]{assumption}

	\declaretheorem[style=thesisdefinition,name=Définition,numberwithin=section]{definition}
	\declaretheorem[style=thesisdefinition,name=Exemple,numberwithin=section]{example}
	\declaretheorem[style=thesisdefinition,name=Remarque,numberwithin=section]{remark}
	
\renewenvironment{proof}[1][Proof]{\noindent\textit{#1}.\nopagebreak\begin{list}{}{\setlength\leftmargin{10pt}}\item}{\end{list}$\square$\medskip}
	\newenvironment{myproof}[1][Démonstration]{\noindent\textit{#1}.\nopagebreak\begin{list}{}{\setlength\leftmargin{10pt}}\item}{\hfill$\diamond$\end{list}\smallskip}
}

	
